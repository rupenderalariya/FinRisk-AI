# FinRisk AI - example configuration
# Copy this file to `.env` and fill in real values.  `.env` is git-ignored.
#
#   PowerShell:  Copy-Item .env.example .env
#
# IMPORTANT: every value here is a placeholder. Never commit real credentials.
# The entire analytics platform runs WITHOUT any AI key configured. The AI layer
# is an optional narration step on top of results that are already computed.

# ---------------------------------------------------------------------------
# AI provider (optional)
# ---------------------------------------------------------------------------
# One of: none | openai | gemini | ollama
# Leave as `none` to run in analytics-only mode.
AI_PROVIDER=none

# Only read when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only read when AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Only read when AI_PROVIDER=ollama (local, needs no key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Shared generation settings
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=800
# Low temperature keeps narration close to the supplied numbers.
AI_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Data locations (relative to the project root)
# ---------------------------------------------------------------------------
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
# Leave blank to let the loader auto-discover the dataset in DATA_RAW_DIR.
RAW_DATASET_FILENAME=

# ---------------------------------------------------------------------------
# Analysis settings
# ---------------------------------------------------------------------------
# Global seed. Keeps splits, KMeans and model fits reproducible.
RANDOM_STATE=42
# Analyses are suppressed rather than computed on a sample this small.
MIN_ROWS_FOR_ANALYSIS=30
# Utilisation above this share of the credit limit counts as "high utilisation".
HIGH_UTILISATION_THRESHOLD=0.80
# IQR multiplier for outlier flagging (1.5 = conventional, 3.0 = extreme only).
OUTLIER_IQR_MULTIPLIER=1.5

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs
