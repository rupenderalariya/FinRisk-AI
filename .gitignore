# --- Secrets: never commit ---
# Ignore every .env variant, then re-admit only the placeholder template.
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
secrets.toml
.streamlit/secrets.toml
.streamlit/credentials.toml
credentials.json
service-account*.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Data: regenerate with scripts/download_data.py + the pipeline ---
# The raw dataset is public but large, so it is fetched rather than committed.
#
# These use `dir/*` rather than `dir/` on purpose. Git cannot re-include a file
# whose parent directory is excluded, so `data/raw/` followed by
# `!data/raw/.gitkeep` would silently fail and the scaffold directory would be
# missing from a fresh clone. Excluding the *contents* keeps the negation working.
data/raw/*
data/processed/*
data/interim/*

# --- Generated artefacts ---
models/*.pkl
models/*.joblib
logs/
*.log

# --- Scratch / experiment files ---
# Throwaway probes are prefixed with an underscore by convention.
_*.py
!__init__.py

# --- Notebooks ---
.ipynb_checkpoints/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json

# --- Keep empty scaffold directories tracked ---
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/interim/.gitkeep
!models/.gitkeep
!reports/.gitkeep
!screenshots/.gitkeep
